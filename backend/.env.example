# Copy to .env for local overrides. Never commit .env.
KORA_APP_NAME="KORA API"
# One of: local, test, staging, production
KORA_ENVIRONMENT=local
KORA_DEBUG=false

# Local development database from compose.yaml (user/password/db: kora/kora/kora).
# Development-only credentials; never put real connection details here.
KORA_DATABASE_URL=postgresql+asyncpg://kora:kora@localhost:5432/kora
KORA_DATABASE_ECHO=false
