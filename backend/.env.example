# Copy to .env for local overrides. Never commit .env.
KORA_APP_NAME="KORA API"
# One of: local, test, staging, production
KORA_ENVIRONMENT=local
KORA_DEBUG=false

# Local development database from compose.yaml (user/password/db: kora/kora/kora).
# Development-only credentials; never put real connection details here. In staging and
# production KORA_DATABASE_URL must be set explicitly and KORA_DEBUG must be false, or the app
# refuses to start.
KORA_DATABASE_URL=postgresql+asyncpg://kora:kora@localhost:5432/kora
KORA_DATABASE_ECHO=false

# Task files: a private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO...). Leave unset to turn
# file uploads off (the endpoints answer 503). Never commit real keys.
# KORA_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# KORA_STORAGE_BUCKET=kora-task-files
# KORA_STORAGE_REGION=auto
# KORA_STORAGE_ACCESS_KEY_ID=
# KORA_STORAGE_SECRET_ACCESS_KEY=
